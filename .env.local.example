# ---------------------------------------------------------------------------
# Refrain — local model access. Copy to `.env.local` and fill in the keys you
# actually use. `.env.local` is gitignored (via `*.local`); this example is not,
# so it must never hold a real key.
#
# Refrain is fully functional with NO keys — directives and lanes are
# deterministic. The LLM is an enhancement for free-form Maestro requests.
#
# WHERE THESE ARE READ
#   npm run dev            ✓ seeded  (import.meta.env.DEV)
#   npm run build:local    ✓ seeded  (vite build --mode localdev)
#   npm run preview:local  ✓ seeded  (local build, then preview on :4173)
#   npm run build          ✗ ignored — a shipping bundle must not carry a key
#   npm test / test:browser ✗ ignored — keeps the suite deterministic
#
# Seeding fills BLANKS only. A key typed into the Providers modal is stored in
# localStorage, wins over this file, and is what the modal shows; clear it to
# hand the slot back here. An env-seeded key is never written to localStorage.
# Routing follows the key: if only one provider is seeded, the online roles
# (directives / generation / theory) point at it on a fresh profile.
#
# SECURITY: Vite inlines every `VITE_`-prefixed var into the client bundle at
# build time, so a key seeded by `build:local` is readable by anyone who loads
# that build. Use it for localhost, not for anything you serve.
# ---------------------------------------------------------------------------

# Anthropic — the default for all three online roles (directives/generation/theory)
VITE_ANTHROPIC_API_KEY=

# OpenAI
VITE_OPENAI_API_KEY=

# Google (Gemini)
VITE_GOOGLE_API_KEY=

# Ollama — local, no key. Override only if it isn't on the default port.
VITE_OLLAMA_ENDPOINT=http://127.0.0.1:11434
